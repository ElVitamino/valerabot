# .env.example
# Токен бота (обязательно)
BOT_TOKEN=your_bot_token_here

# ID главного админа (обязательно)
MAIN_ADMIN_ID=123456789

# ID основной группы (опционально)
# Если не указать - статистика будет везде
# MAIN_GROUP_ID=-1001234567890

# Файлы и настройки
DATA_FILE=iris_data.json
LOG_FILE=iris_bot.log
BACKUP_DIR=backups

# Настройки модерации
DEFAULT_MUTE_MINUTES=30
DEFAULT_WARN_DAYS=30
MAX_WARNINGS=7

# Репутация
REPUTATION_COOLDOWN=3600
REPUTATION_DAILY_LIMIT=15

# VIP ранг для РП команд
VIP_RP_RANK=2

# Интервалы
MUTE_CHECK_INTERVAL=60
AUTO_SAVE_INTERVAL=300

# Анти-спам
ANTI_SPAM_ENABLED=true